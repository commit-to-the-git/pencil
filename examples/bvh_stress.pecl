# bvh_stress.pecl - A scene with many primitives to demonstrate BVH speedup.
# 1000 spheres arranged in a 10x10x10 grid, each with a random color.
#
# Render with: pencil bvh_stress.pecl --quiet
# Render without BVH: pencil bvh_stress.pecl --no-bvh --quiet
#
# The BVH version should be 10-50x faster than the linear version.

bg: <10, 12, 16>
amb: <8, 8, 10>

cmra {
  pos: <12, 12, -12>
  aim: <0, 0, 0>
  up:  <0, 1, 0>
  fov: 45
}

# Ground plane.
mat { clr: <30, 30, 35> }
plane { pos: <0, -5, 0>, nrm: <0, 1, 0> }

mat { clr: <74, 31, 49>, rfl: 6 }
sphere { pos: <-3.60, -3.60, -3.60>, rad: 0.3 }
mat { clr: <81, 77, 92>, rfl: 2 }
sphere { pos: <-3.60, -3.60, -2.80>, rad: 0.3 }
