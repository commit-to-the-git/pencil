# fog_test.pecl - volumetric fog demo.
# three spheres in fog. distant objects fade into the fog color.

bg: <5, 6, 9>
amb: <8, 8, 10>

fog {
  density: 0.08
  color: <30, 35, 45>
}

cmra {
  pos: <0, 1.5, -6>
  aim: <0, 0, 0>
  up:  <0, 1, 0>
  fov: 55
}

mat { clr: <50, 50, 55> }
plane { pos: <0, -1, 0>, nrm: <0, 1, 0> }

mat { clr: <80, 20, 20>, spc: 30, shn: 64 }
sphere { pos: <-2, 0, 2>, rad: 0.8 }

mat { clr: <20, 70, 30>, spc: 30, shn: 64 }
sphere { pos: <0, 0, 0>, rad: 0.8 }

mat { clr: <20, 30, 80>, spc: 30, shn: 64 }
sphere { pos: <2, 0, -2>, rad: 0.8 }

light {
  type: point
  pos:  <4, 6, -4>
  clr:  <100, 100, 95>
  radius: 0.5
}

render {
  size: 480 360
  spp: 2
  depth: 4
}
