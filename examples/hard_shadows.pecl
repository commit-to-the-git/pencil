# hard_shadows.pecl - same scene as soft_shadows.pecl but with hard shadows.
# radius: 0 disables soft shadow sampling.

bg: <5, 6, 9>
amb: <8, 8, 10>

cmra {
  pos: <0, 2, -5>
  aim: <0, 0, 0>
  up:  <0, 1, 0>
  fov: 50
}

mat { clr: <50, 50, 55> }
plane { pos: <0, -1, 0>, nrm: <0, 1, 0> }

mat { clr: <100, 60, 30>, spc: 30, shn: 64 }
sphere { pos: <0, 0, 0>, rad: 1 }

light {
  type: point
  pos:  <2, 5, -2>
  clr:  <100, 100, 95>
  radius: 0
}

render {
  size: 640 480
  spp: 4
  depth: 6
}
