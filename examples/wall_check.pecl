# wall_check.pecl - just the wall, no sphere, to verify orientation
bg: <5, 5, 5>
amb: <10, 10, 10>

cmra {
  pos: <0, 0, -4>
  aim: <0, 0, 0>
  up:  <0, 1, 0>
  fov: 45
}

# top half of back wall - bright white (emissive)
mat { clr: <100, 100, 100>, emt: <100, 100, 100> }
quad {
  a: <-3, 0, 3>
  b: <3, 0, 3>
  c: <3, 3, 3>
  d: <-3, 3, 3>
}

# bottom half of back wall - pure black
mat { clr: <0, 0, 0> }
quad {
  a: <-3, -3, 3>
  b: <3, -3, 3>
  c: <3, 0, 3>
  d: <-3, 0, 3>
}

render {
  size: 240 240
  spp: 1
  depth: 1
}
