# volumetric light transport test. fog with a sphere in it.
# light should scatter through the fog (visible light shafts).
bg: <2, 3, 5>
amb: <5, 5, 5>

cmra {
  pos: <0, 1, -5>
  aim: <0, 0, 0>
  up:  <0, 1, 0>
  fov: 50
}

mat { clr: <50, 50, 55> }
plane { pos: <0, -1, 0>, nrm: <0, 1, 0> }

mat { clr: <100, 100, 100>, ior: 1.5 }
sphere { pos: <0, 0, 0>, rad: 1 }

# fog: density 0.15, gray color
fog {
  density: 0.15
  color: <60, 60, 80>
}

light {
  type: point
  pos:  <3, 4, -4>
  clr:  <100, 100, 95>
  radius: 0
}

render {
  size: 480 360
  spp: 2
  depth: 4
}
